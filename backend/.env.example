# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Option 1 (tried first for text tasks): an OpenAI API key, or a key for any OpenAI-compatible service.
AI_GATEWAY_API_KEY=
# Optional. Default: https://api.openai.com/v1 . Set it when you use another OpenAI-compatible service.
AI_GATEWAY_BASE_URL=
# Optional. Models for text tasks, tried in order. Default: gpt-6.1-sol (names differ between services)
AI_GATEWAY_MODELS=
# Optional. Models for voice recordings (must accept audio). Default: gemini-3.8-flash. GPT option: gpt-audio-1.5
AI_GATEWAY_AUDIO_MODELS=
# Optional. low / medium / high. Empty = the model's default.
AI_GATEWAY_REASONING_EFFORT=

# Option 2: Google AI Studio → Get API key (free tier). Used first for voice recordings,
# and for text tasks when option 1 is missing or fails.
GEMINI_API_KEY=
# Optional. Models tried in order when one hits its free-tier limit.
# Default: gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MODELS=
# Optional. Send Gemini requests to a service that offers the Gemini API format instead of Google
# (put that service's key in GEMINI_API_KEY).
GEMINI_BASE_URL=
# Optional. Models for voice recordings (tried before the AI gateway). Default: GEMINI_MODELS.
# Recommended: gemini-3.5-flash-lite,gemini-3.8-flash (fast and good with mixed languages)
GEMINI_AUDIO_MODELS=
# Optional. low (default) is fast. Use none for models without thinking levels.
GEMINI_THINKING_LEVEL=
# Frontend URLs allowed to call this server (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
