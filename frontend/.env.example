# Copy this file to .env.local and fill in the values. .env.local is git-ignored.

# Supabase → Project Settings → API (or "Connect" button)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Never put the secret/service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend (FastAPI) base URL. Leave empty to use the built-in mock answers instead of the AI.
VITE_API_BASE_URL=http://localhost:8000
